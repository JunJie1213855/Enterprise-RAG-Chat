# =============================================================
# Enterprise Chatbot - Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# ---- App ----
ENVIRONMENT=development
DEBUG=true
APP_NAME="Enterprise Chatbot"
SECRET_KEY=change-this-to-a-long-random-string-in-production

# ---- Database ----
POSTGRES_DB=chatbot_db
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_pass
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot_pass@db:5432/chatbot_db

# ---- Redis ----
REDIS_PASSWORD=redis_pass
REDIS_URL=redis://:redis_pass@redis:6379/0

# ---- JWT ----
JWT_SECRET_KEY=another-long-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ---- LLM / Embedding (OpenAI-compatible endpoints) ----
# OPENAI_* is the shared fallback for both services below.
# Point LLM_* / EMBEDDING_* at separate providers to mix and match.
# Leave BASE_URL blank to use the official OpenAI API.

# Shared fallback
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-...your-key-here...

# Chat / LLM (falls back to OPENAI_* when blank)
LLM_BASE_URL=
LLM_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2048
OPENAI_TEMPERATURE=0.7

# Embeddings (falls back to OPENAI_* when blank)
# NOTE: EMBEDDING_DIMENSION and the vector(1536) column in database/init.sql
# must match the chosen embedding model (e.g. 1024 for bge-m3).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- RAG ----
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_PER_HOUR=300
RATE_LIMIT_PER_DAY=1000

# ---- CORS ----
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---- Logging ----
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ---- Frontend (Vite) ----
VITE_API_URL=/api/v1
